# Tabulation - iterative method
n=5
dp=[-1]*(n+1)
dp[0]=0
dp[1]=1
for i in range(2,n+1):
    dp[i%3]=dp[(i-1)%3]+dp[(i-2)%3]
print(dp[n%3])


